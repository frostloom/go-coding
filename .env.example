# go-coding live 密钥模板 —— 复制为 .env 并填上你的 OPENAI_API_KEY。
#
# 三个入口（cmd/agent / cmd/harness / cmd/worker）启动时自动加载**根目录 .env**：
#   cp .env.example .env   # 然后编辑 .env 填密钥
# .env 已被 .gitignore 忽略，密钥不会进仓库。shell 里已 export 的同名变量优先
# （.env 只补缺，不覆盖），所以脚本里手动 export 仍然有效。

# live 网关（见 scripts/run-live.sh）
OPENAI_BASE_URL=https://sudobug.top/v1
OPENAI_MODEL=gpt-5.6-luna
# 把你的密钥填进 .env（不要填进 .env.example —— 这个文件是提交的模板）
OPENAI_API_KEY=
# P22 模型分级：executor worker 用的模型（空 = 继承 OPENAI_MODEL）。
# 想让 planner 用强模型、executor 用便宜模型就填这里；-executor-model flag 优先于它。
# 例：planner 用 gpt-5.6-terra → executor 填 gpt-5.6-sol；两角色同模型就不填。
# OPENAI_EXECUTOR_MODEL=

# 本地模型备选（Ollama OpenAI 兼容端点，零改动，见 README）
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
