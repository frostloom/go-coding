# go-coding model settings — copy to %USERPROFILE%\.go-coding.env and fill in.
# The agent CLI loads this file automatically, so a built binary starts
# straight into a conversation without re-typing model settings.
# Real environment variables always win over this file.
#
#   Windows:  copy to C:\Users\<you>\.go-coding.env
#   macOS:    cp scripts/go-coding.env.example ~/.go-coding.env

# Cloud gateway (fill in your own key — never commit a real key to a repo).
OPENAI_BASE_URL=https://sudobug.top/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=sk-your-key-here

# Or a local model via Ollama (no key needed):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Streaming is on by default; keep it on for the live terminal.
LLM_STREAM=true
